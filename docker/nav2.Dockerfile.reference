# Reference only: the camera-ready states that the simulator used an image based on
# osrf/ros:humble-desktop extended with TurtleBot4 simulator/navigation and Nav2.
# The exact original package installation commands and pinned versions must be restored
# from the experiment environment before this file is used for archival reproduction.

FROM osrf/ros:humble-desktop

SHELL ["/bin/bash", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-navigation2 \
    ros-humble-nav2-bringup \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

